# Frontend: set this value in Vercel for production deployments.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend: set a persistent Railway database URL for production deployments.
# The local default is a file in backend/data/, never a temporary directory.
DATABASE_URL=sqlite:///./data/fireflies.db

# Backend: set this to the Vercel origin after deployment.
CORS_ORIGINS=["http://localhost:3000"]

# Optional Gemini features. Keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Persist uploaded recordings on Railway's mounted volume in production.
UPLOAD_DIR=./data/uploads
